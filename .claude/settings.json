{
  "extraKnownMarketplaces": {
    "seethestars-plugins": {
      "source": {
        "source": "github",
        "repo": "kellyblaze/seethestars"
      }
    }
  },
  "enabledPlugins": {
    "frontend-design@seethestars-plugins": true,
    "superpowers@seethestars-plugins": true,
    "scientific-skills@seethestars-plugins": true,
    "fullstack-dev-skills@seethestars-plugins": true
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(node -e *)",
      "Bash(npx @cobusgreyling/loop@0.1.2 doctor*)",
      "Bash(npx @cobusgreyling/loop@0.1.2 sync*)",
      "Bash(npx @cobusgreyling/loop@0.1.2 cost*)"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(npm install*)",
      "Bash(npx @cobusgreyling/loop init*)"
    ],
    "deny": [
      "Read(.env*)",
      "Bash(git push --force*)",
      "Bash(git merge*)",
      "Bash(git reset --hard*)",
      "Bash(rm*)",
      "Bash(curl*)",
      "Bash(wget*)"
    ]
  }
}
